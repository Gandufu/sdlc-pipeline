{
  "name": "@heli/main",
  "version": "0.1.0",
  "private": true,
  "description": "Heli Conference Terminal — Electron main process",
  "author": "Heli",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,green \"pnpm --filter @heli/renderer dev\" \"wait-on tcp:5173 && tsc -w & cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc",
    "build:renderer": "pnpm --filter @heli/renderer build",
    "prepackage": "node ../../scripts/prepackage-wincode-sign.cjs",
    "package": "pnpm --filter @heli/shared build && pnpm build && pnpm build:renderer && electron-builder",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.heli.terminal",
    "productName": "Heli Conference Terminal",
    "directories": {
      "output": "../../out",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../renderer/dist",
        "to": "renderer"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Heli Conference Terminal"
    }
  },
  "dependencies": {
    "@heli/shared": "workspace:*",
    "axios": "1.7.2"
  },
  "devDependencies": {
    "concurrently": "8.2.2",
    "cross-env": "7.0.3",
    "electron": "30.0.0",
    "electron-builder": "24.13.3",
    "msw": "2.2.0",
    "wait-on": "7.2.0",
    "typescript": "5.4.5",
    "vitest": "1.6.0",
    "@types/node": "20.12.7"
  }
}
