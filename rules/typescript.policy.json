{
  "schema_version": "1.0",
  "rule_id": "typescript",
  "classification": ["guidance", "hard", "executable"],
  "hard_invariants": [
    {
      "id": "no-explicit-any",
      "kind": "forbidden_regex",
      "paths": ["**/*.ts", "**/*.tsx"],
      "pattern": "(:\\s*any\\b|\\bas\\s+any\\b|<any>)",
      "max_bytes": 500000
    }
  ],
  "executable_verifiers": [
    {"id": "lint", "phase": "code", "command_key": "lint"},
    {"id": "typecheck", "phase": "code", "command_key": "typecheck"}
  ]
}
