{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-pipeline.local/schemas/feature-contract.schema.json",
  "type": "object",
  "required": ["schema_version", "spec_confirmed", "feature", "design", "verification"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "spec_confirmed": {"const": true},
    "feature": {
      "type": "object",
      "required": [
        "id", "title", "goal", "actor", "source_refs", "scope", "non_goals",
        "domain_data", "main_flow", "alternate_flows", "acceptance_criteria"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^F-[0-9]{4}$"},
        "title": {"type": "string", "minLength": 1},
        "goal": {"type": "string", "minLength": 1},
        "actor": {"type": "string", "minLength": 1},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["source_id", "anchor"],
            "properties": {
              "source_id": {"type": "string", "pattern": "^SRC-[A-F0-9]{12}$"},
              "anchor": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "domain_data": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "description": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "main_flow": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "alternate_flows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "steps"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "given", "when", "then"],
            "properties": {
              "id": {"type": "string", "pattern": "^AC-[0-9]{4}$"},
              "given": {"type": "string", "minLength": 1},
              "when": {"type": "string", "minLength": 1},
              "then": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "design": {
      "type": "object",
      "required": ["modules", "interfaces", "data_contracts", "extension_points", "decisions"],
      "properties": {
        "modules": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "responsibility", "seam"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "responsibility": {"type": "string", "minLength": 1},
              "seam": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "input", "output", "errors"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "input": {"type": "string"},
              "output": {"type": "string"},
              "errors": {"type": "array", "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          }
        },
        "data_contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "fields"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "type", "required", "source"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "type": {"type": "string", "minLength": 1},
                    "required": {"type": "boolean"},
                    "source": {"type": "string", "minLength": 1}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "extension_points": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "decisions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ac_id", "test_key", "level", "expected"],
        "properties": {
          "ac_id": {"type": "string", "pattern": "^AC-[0-9]{4}$"},
          "test_key": {"type": "string", "minLength": 1},
          "level": {"enum": ["unit", "integration"]},
          "expected": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
