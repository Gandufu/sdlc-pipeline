{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-pipeline.local/schemas/spec.schema.json",
  "type": "object",
  "required": ["schema_version", "flow", "spec_confirmed", "requirements", "design", "test_plan"],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "flow": {"enum": ["standard", "incremental"]},
    "spec_confirmed": {"const": true},
    "incremental_confirmed": {"type": "boolean"},
    "requirements": {
      "type": "object",
      "required": ["source_inputs", "analysis", "items"],
      "properties": {
        "source_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["source", "content"],
                "properties": {
                  "source": {"type": "string", "minLength": 1},
                  "content": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "schema_version", "source_id", "kind", "source", "media_type",
                  "sha256", "extractor", "segments", "content", "ingested_at"
                ],
                "properties": {
                  "schema_version": {"const": "1.0"},
                  "source_id": {"type": "string", "pattern": "^SRC-[A-F0-9]{12}$"},
                  "kind": {"enum": ["inline", "file", "url", "document"]},
                  "source": {"type": "string", "minLength": 1},
                  "uri": {"type": ["string", "null"]},
                  "media_type": {"type": "string", "minLength": 1},
                  "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                  "extractor": {
                    "type": "object",
                    "required": ["name", "version"],
                    "properties": {
                      "name": {"type": "string", "minLength": 1},
                      "version": {"type": "string", "minLength": 1}
                    },
                    "additionalProperties": false
                  },
                  "segments": {"type": "array", "minItems": 1},
                  "content": {"type": "string", "minLength": 1},
                  "ingested_at": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "analysis": {
          "type": "object",
          "required": [
            "confirmed_facts", "impact_scope", "assumptions",
            "open_questions", "risks", "decisions"
          ],
          "properties": {
            "confirmed_facts": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "impact_scope": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "assumptions": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "open_questions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "question", "blocking", "status"],
                "properties": {
                  "id": {"type": "string", "pattern": "^Q-[0-9]{4}$"},
                  "question": {"type": "string", "minLength": 1},
                  "blocking": {"type": "boolean"},
                  "status": {"enum": ["open", "resolved"]},
                  "resolution": {"type": "string", "minLength": 1}
                },
                "allOf": [{
                  "if": {
                    "properties": {"status": {"const": "resolved"}},
                    "required": ["status"]
                  },
                  "then": {"required": ["resolution"]}
                }],
                "additionalProperties": false
              }
            },
            "risks": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "decisions": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            }
          },
          "additionalProperties": false
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title", "description", "acceptance_criteria"],
            "properties": {
              "id": {"type": "string", "pattern": "^R-[0-9]{4}$"},
              "title": {"type": "string"},
              "description": {"type": "string"},
              "acceptance_criteria": {
                "type": "array", "minItems": 1,
                "items": {
                  "oneOf": [
                    {"type": "string", "minLength": 1},
                    {
                      "type": "object",
                      "required": ["id", "description", "source_refs"],
                      "properties": {
                        "id": {"type": "string", "pattern": "^AC-R-[0-9]{4}-[0-9]{2}$"},
                        "description": {"type": "string", "minLength": 1},
                        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "supersedes": {"type": ["string", "null"], "pattern": "^R-[0-9]{4}$"},
              "source_refs": {
                "type": "array", "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "change_flags": {"type": "object"}
      }
    },
    "design": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title", "description", "requirement_ids", "module", "extension_point", "allowed_paths"],
            "properties": {
              "id": {"type": "string", "pattern": "^D-[0-9]{4}$"},
              "title": {"type": "string"},
              "description": {"type": "string"},
              "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^R-[0-9]{4}$"}},
              "module": {"type": "string"},
              "extension_point": {"type": "string"},
              "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "interfaces": {"type": "array", "items": {"type": "string"}},
              "data_model": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "test_plan": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title", "requirement_ids", "design_ids", "level", "preconditions", "input", "expected", "mandatory", "command"],
            "properties": {
              "id": {"type": "string", "pattern": "^T-[0-9]{4}$"},
              "title": {"type": "string"},
              "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^R-[0-9]{4}$"}},
              "design_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^D-[0-9]{4}$"}},
              "level": {"enum": ["unit", "integration"]},
              "preconditions": {"type": "string"},
              "input": {"type": "string"},
              "expected": {"type": "string"},
              "mandatory": {"type": "boolean"},
              "command": {
                "type": "string",
                "minLength": 1,
                "description": "lifecycle.json tests 中的逻辑键（如 unit），不是 pnpm test 等 shell 命令"
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
