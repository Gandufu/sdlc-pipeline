{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-pipeline.local/schemas/artifacts/verification.schema.json",
  "type": "object",
  "required": [
    "schema_version", "id", "requirement_ids", "design_ids",
    "acceptance_criteria_ids", "level", "test_key", "selector",
    "preconditions", "expected", "mandatory"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "id": {"type": "string", "pattern": "^T-[0-9]{4}$"},
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^R-[0-9]{4}$"}
    },
    "design_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^D-[0-9]{4}$"}
    },
    "acceptance_criteria_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^AC-R-[0-9]{4}-[0-9]{2}$"}
    },
    "level": {"const": "functional"},
    "test_key": {"type": "string", "minLength": 1},
    "selector": {
      "type": "string",
      "pattern": "^tests/functional/.+\\.functional\\.ts$"
    },
    "preconditions": {"type": "string", "minLength": 1},
    "expected": {"type": "string", "minLength": 1},
    "mandatory": {"type": "boolean"},
    "test_basis": {
      "type": "string",
      "enum": ["acceptance", "risk", "regression", "contract"]
    },
    "intent": {"type": "string", "minLength": 1},
    "coverage": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
