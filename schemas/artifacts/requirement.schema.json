{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-pipeline.local/schemas/artifacts/requirement.schema.json",
  "type": "object",
  "required": [
    "schema_version", "id", "feature_id", "title", "goal", "actor",
    "scope", "non_goals", "main_flow", "alternate_flows",
    "acceptance_criteria"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "id": {"type": "string", "pattern": "^R-[0-9]{4}$"},
    "feature_id": {"type": "string", "pattern": "^F-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "non_goals": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "decision_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^Q-[0-9]{4}$"}
    },
    "main_flow": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "alternate_flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "steps"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "given", "when", "then"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-R-[0-9]{4}-[0-9]{2}$"
          },
          "given": {"type": "string", "minLength": 1},
          "when": {"type": "string", "minLength": 1},
          "then": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "supersedes": {
      "type": ["string", "null"],
      "pattern": "^R-[0-9]{4}$"
    }
  },
  "additionalProperties": false
}
