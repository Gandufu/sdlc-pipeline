{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-pipeline.local/schemas/artifacts/delivery-trace.schema.json",
  "type": "object",
  "required": [
    "schema_version", "baseline_id", "source_fingerprint",
    "rows", "ok", "incomplete"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "baseline_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement_id", "design_ids", "changed_files",
          "verification", "commits", "precision"
        ],
        "properties": {
          "requirement_id": {"type": "string", "pattern": "^R-[0-9]{4}$"},
          "design_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^D-[0-9]{4}$"}
          },
          "changed_files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
              },
              "additionalProperties": false
            }
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["test_id", "selector", "result_ref", "precision"],
              "properties": {
                "test_id": {"type": "string", "pattern": "^T-[0-9]{4}$"},
                "selector": {"type": "string", "minLength": 1},
                "result_ref": {"type": "string", "minLength": 1},
                "precision": {"const": "direct"}
              },
              "additionalProperties": false
            }
          },
          "commits": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "precision": {"enum": ["scoped", "shared"]}
        },
        "additionalProperties": false
      }
    },
    "ok": {"type": "boolean"},
    "incomplete": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
