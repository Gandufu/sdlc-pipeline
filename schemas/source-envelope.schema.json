{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-pipeline.local/schemas/source-envelope.schema.json",
  "type": "object",
  "required": [
    "schema_version", "source_id", "kind", "source", "media_type",
    "sha256", "extractor", "segments", "content", "ingested_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_id": {"type": "string", "pattern": "^SRC-[A-F0-9]{12}$"},
    "kind": {"enum": ["inline", "file", "url", "document"]},
    "source": {"type": "string", "minLength": 1},
    "uri": {"type": ["string", "null"]},
    "media_type": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "extractor": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["anchor", "text", "sha256"],
        "properties": {
          "anchor": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "content": {"type": "string", "minLength": 1},
    "asset": {
      "type": "object",
      "required": ["original_uri", "uri", "sha256", "size", "copied_at"],
      "properties": {
        "original_uri": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size": {"type": "integer", "minimum": 0},
        "copied_at": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "ingested_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
