{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-pipeline.local/schemas/v2/candidate-manifest.schema.json",
  "type": "object",
  "required": [
    "schema_version", "candidate_id", "revision", "feature_map",
    "requirements", "designs", "verification", "source_refs", "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "candidate_id": {"type": "string", "pattern": "^SC-[0-9]{6}$"},
    "revision": {"type": "integer", "minimum": 1},
    "feature_map": {"$ref": "#/$defs/file_record"},
    "requirements": {"$ref": "#/$defs/file_records"},
    "designs": {"$ref": "#/$defs/file_records"},
    "verification": {"$ref": "#/$defs/file_records"},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "anchor"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^SRC-[A-F0-9]{12}$"},
          "anchor": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "$defs": {
    "file_record": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "file_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
