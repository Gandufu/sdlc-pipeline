{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-pipeline.local/schemas/v2/approval.schema.json",
  "type": "object",
  "required": [
    "schema_version", "candidate_id", "revision", "content_hash",
    "decision", "confirmed", "confirmed_at", "published_bundle_id"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "candidate_id": {"type": "string", "pattern": "^SC-[0-9]{6}$"},
    "revision": {"type": "integer", "minimum": 1},
    "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "decision": {"const": "approved"},
    "confirmed": {"const": true},
    "confirmed_at": {"type": "string", "minLength": 1},
    "published_bundle_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
