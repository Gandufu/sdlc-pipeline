{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-pipeline.local/schemas/v2/candidate-pointer.schema.json",
  "type": "object",
  "required": [
    "schema_version", "candidate_id", "current_revision", "state",
    "current_hash", "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "candidate_id": {"type": "string", "pattern": "^SC-[0-9]{6}$"},
    "current_revision": {"type": "integer", "minimum": 1},
    "state": {"enum": ["draft", "ready", "rejected", "published"]},
    "current_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "updated_at": {"type": "string", "minLength": 1},
    "published_bundle_id": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
