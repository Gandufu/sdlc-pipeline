{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-pipeline.local/schemas/v2/verification.schema.json",
  "type": "object",
  "required": [
    "schema_version", "id", "requirement_ids", "design_ids",
    "acceptance_criteria_ids", "level", "test_key", "selector",
    "preconditions", "expected", "mandatory"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "id": {"type": "string", "pattern": "^T-[0-9]{4}$"},
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^R-[0-9]{4}$"}
    },
    "design_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^D-[0-9]{4}$"}
    },
    "acceptance_criteria_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^AC-R-[0-9]{4}-[0-9]{2}$"}
    },
    "level": {"enum": ["unit", "integration", "functional"]},
    "test_key": {"type": "string", "minLength": 1},
    "selector": {"type": ["string", "null"]},
    "preconditions": {"type": "string", "minLength": 1},
    "expected": {"type": "string", "minLength": 1},
    "mandatory": {"type": "boolean"}
  },
  "additionalProperties": false
}
