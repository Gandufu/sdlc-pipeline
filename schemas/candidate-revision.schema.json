{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-pipeline.local/schemas/candidate-revision.schema.json",
  "type": "object",
  "required": [
    "schema_version", "candidate_id", "revision", "state", "candidate",
    "feature_map", "requirements", "designs", "verification", "decisions", "source_refs",
    "content_hash", "validation", "preview", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "candidate_id": {"type": "string", "pattern": "^SC-[0-9]{6}$"},
    "revision": {"type": "integer", "minimum": 1},
    "state": {"enum": ["draft", "ready"]},
    "candidate": {"$ref": "#/$defs/content_ref"},
    "feature_map": {"$ref": "artifacts/feature-map.schema.json"},
    "requirements": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact_ref"}
    },
    "designs": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact_ref"}
    },
    "verification": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact_ref"}
    },
    "decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact_ref"}
    },
    "source_refs": {
      "type": "array",
      "items": {"$ref": "artifacts/source-ref.schema.json#/$defs/source_ref"}
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "validation": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/validation_ref"}
      ]
    },
    "preview": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/content_ref"}
      ]
    },
    "created_at": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "content_ref": {
      "type": "object",
      "required": ["content_ref", "sha256"],
      "properties": {
        "content_ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "validation_ref": {
      "type": "object",
      "required": ["ok", "content_ref", "sha256"],
      "properties": {
        "ok": {"type": "boolean"},
        "content_ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "artifact_ref": {
      "type": "object",
      "required": ["id", "artifact_revision", "content_ref", "sha256"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(R|D|T|Q)-[0-9]{4}$"
        },
        "artifact_revision": {"type": "integer", "minimum": 1},
        "content_ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
