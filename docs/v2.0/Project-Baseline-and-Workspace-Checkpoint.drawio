        <mxCell id="verified" value="验证通过&#xa;verified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#00875A;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1320" y="1248" width="190" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="resume" value="外部条件恢复&#xa;继续原 TASK-xxxx&#xa;不创建新 Checkpoint ID" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#FF991F;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1450" y="1118" width="250" height="100" as="geometry"/>
