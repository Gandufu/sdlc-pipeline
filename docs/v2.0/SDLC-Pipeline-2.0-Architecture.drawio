        <mxCell id="s-draft" value="草稿&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;增量提案编辑/校验&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#0052CC;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="210" y="180" width="190" height="110" as="geometry"/></mxCell>
