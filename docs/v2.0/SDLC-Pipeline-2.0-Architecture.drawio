        <mxCell id="h-product" value="产品问题 → 代码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DE350B;" vertex="1" parent="h1"><mxGeometry x="680" y="410" width="200" height="55" as="geometry"/></mxCell>
