        <mxCell id="s-rule" value="内核守卫决定目标状态；模型只能提交事件和证据。返工保留历史证据，只失效受影响的下游门禁运行与批准。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#7A869A;fontColor=#172B4D;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="210" y="680" width="1230" height="90" as="geometry"/></mxCell>
