        <mxCell id="h-evidence" value="下一次尝试必须有新的失败增量：新失败、新定位、新环境状态或新假设验证。相同指纹重复且无新证据时停止。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#7A869A;fontStyle=1;" vertex="1" parent="h1"><mxGeometry x="70" y="650" width="1480" height="85" as="geometry"/></mxCell>
